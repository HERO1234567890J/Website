# ────────────────────────────────────────────────────────────────────
# D-Trips backend — .env.example
#
# Copy to `.env` and fill in real values. Never commit `.env`.
# Every var here is referenced via ConfigService — there is no fallback.
# ────────────────────────────────────────────────────────────────────

# App
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# Database (Prisma) — Postgres
DATABASE_URL=postgresql://dtrips:dtrips@localhost:5432/dtrips

# Auth — JWT (hand-rolled per §13; NO NextAuth/Clerk/Passport)
JWT_SECRET=replace-me-with-32-byte-random-string
JWT_REFRESH_SECRET=replace-me-with-32-byte-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12

# EasyCash — payment gateway (§11). Real credentials pending.
# The PaymentService interface treats these as opaque; nothing in the
# codebase should depend on the exact field names below.
EASYCASH_BASE_URL=https://api.easycash.example
EASYCASH_API_KEY=
EASYCASH_WEBHOOK_SECRET=

# Email — Resend (§12)
RESEND_API_KEY=
EMAIL_FROM=bookings@d-trips.com
EMAIL_REPLY_TO=hello@d-trips.com

# Storage / CDN — Bunny (§3)
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_API_KEY=
BUNNY_CDN_BASE=

# Error monitoring — Sentry (§30)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Logging
LOG_LEVEL=info