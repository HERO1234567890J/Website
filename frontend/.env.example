# example env — copy to .env.local for real values.
# VITE_API_BASE_URL points the frontend at the NestJS API. The default
# matches backend/.env.example so a fresh dev setup works without
# any env files. The new `VITE_API_URL` supersedes it and includes
# the `/api` path segment so the api() wrapper can use relative
# paths inside the client.
VITE_API_BASE_URL=http://localhost:3000
VITE_API_URL=http://localhost:3001/api

# Error monitoring — Sentry (§30). Leave empty to disable (no-op SDK).
VITE_SENTRY_DSN=

# Analytics — Google Analytics 4 (§31). Leave empty to disable.
# Instrumentation stays inert until the visitor grants cookie consent.
VITE_GA_MEASUREMENT_ID=