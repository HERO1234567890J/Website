# ────────────────────────────────────────────────────────────────────
# D-Trips — root .env.example (§22 / docker-compose)
#
# Copy to `.env` and fill in real values. Never commit `.env`.
# All secrets are passed to containers via docker-compose environment.
# ────────────────────────────────────────────────────────────────────

# ─── PostgreSQL ────────────────────────────────────────────────────
POSTGRES_USER=dtrips
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=dtrips
POSTGRES_PORT=5432

# ─── Backend (NestJS) ─────────────────────────────────────────────
NODE_ENV=production
PORT=3001
BACKEND_PORT=3001
APP_URL=https://your-domain.com
API_URL=https://your-domain.com/api

# JWT — generate with: openssl rand -hex 32
JWT_SECRET=replace-me-with-32-byte-random-string
JWT_REFRESH_SECRET=replace-me-with-32-byte-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12

# EasyCash — payment gateway (§11). Real credentials pending.
EASYCASH_BASE_URL=https://api.easycash.example
EASYCASH_API_KEY=
EASYCASH_WEBHOOK_SECRET=

# Email — Resend (§12)
RESEND_API_KEY=
EMAIL_FROM=bookings@d-trips.com
EMAIL_REPLY_TO=hello@d-trips.com

# Storage / CDN — Bunny (§3)
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_API_KEY=
BUNNY_CDN_BASE=

# Error monitoring — Sentry (§30)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Logging
LOG_LEVEL=info

# ─── Frontend (Vite build args) ───────────────────────────────────
# In docker-compose these are passed as build args to Vite.
FRONTEND_PORT=80
VITE_API_BASE_URL=
VITE_API_URL=/api
VITE_SENTRY_DSN=
VITE_GA_MEASUREMENT_ID=
